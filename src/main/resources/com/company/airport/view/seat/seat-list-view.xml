<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://seatListView.title"
      focusComponent="seatsDataGrid">
    <data>
        <collection id="seatsDc"
                    class="com.company.airport.entity.Seat">
            <fetchPlan extends="_base">
                <property name="aircraft" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="seatsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Seat e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="seatsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="seatsDataGrid.createAction"/>
            <button id="editButton" action="seatsDataGrid.editAction"/>
            <button id="removeButton" action="seatsDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="seatsDl"/>
        </hbox>
        <dataGrid id="seatsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="seatsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="seatNumber"/>
                <column property="seatClass"/>
                <column property="aircraft"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
