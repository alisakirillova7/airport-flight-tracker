<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://ticketListView.title"
      focusComponent="ticketsDataGrid">
    <data>
        <collection id="ticketsDc"
                    class="com.company.airport.entity.Ticket">
            <fetchPlan extends="_base">
                <property name="flight" fetchPlan="_base">
                    <property name="departureAirport" fetchPlan="_base"/>
                    <property name="arrivalAirport" fetchPlan="_base"/>
                </property>
                <property name="passenger" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="ticketsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Ticket e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="ticketsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="ticketsDataGrid.createAction"/>
            <button id="editButton" action="ticketsDataGrid.editAction"/>
            <button id="removeButton" action="ticketsDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="ticketsDl"/>
        </hbox>
        <dataGrid id="ticketsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="ticketsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="ticketNumber"/>
                <column property="flightSeat.seat.seatNumber"/>
                <column property="flight"/>
                <column property="passenger"/>
                <column property="price"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
