<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://flightDetailView.title"
      focusComponent="form">
    <data>
        <instance id="flightDc"
                  class="com.company.airport.entity.Flight">
            <fetchPlan extends="_base">
                <property name="airline" fetchPlan="_base"/>
                <property name="departureAirport" fetchPlan="_base"/>
                <property name="arrivalAirport" fetchPlan="_base"/>
                <property name="aircraft" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="flightDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="flightDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="numberField" property="number"/>
            <entityPicker id="airlineField" property="airline">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="departureAirportField" property="departureAirport">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="arrivalAirportField" property="arrivalAirport">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>

            <dateTimePicker id="departureTimeField" property="departureTime"/>
            <dateTimePicker id="arrivalTimeField" property="arrivalTime"/>
            <entityPicker property="aircraft">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
            <button id="generateSeatsBtn"
                    text="Сгенерировать места"
                    icon="AIRPLANE"
                    themeNames="primary success"/>
        </hbox>
    </layout>
</view>