<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://passengerListView.title"
      focusComponent="passengersDataGrid">
    <data>
        <collection id="passengersDc"
                    class="com.company.airport.entity.Passenger">
            <fetchPlan extends="_base"/>
            <loader id="passengersDl" readOnly="true">
                <query>
                    <![CDATA[select e from Passenger e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="passengersDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="passengersDataGrid.createAction"/>
            <button id="editButton" action="passengersDataGrid.editAction"/>
            <button id="removeButton" action="passengersDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="passengersDl"/>
        </hbox>
        <dataGrid id="passengersDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="passengersDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="firstName"/>
                <column property="lastName"/>
                <column property="passportNumber"/>
                <column property="email"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
